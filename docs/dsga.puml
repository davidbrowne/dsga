@startuml
	'skin rose
	title Relationships - Class Diagram
	class "vec_like" <<concept>>
	{
		+ vec_scalar_t<V>
		+ vec_derived_t<V>
		+ vec_writable_v<V>
		+ {static} size()
		+ operator[](int) : const
		+ operator[](size_t) : const
		+ at(int) : const
		+ at(size_t) : const
		+ begin() / rbegin() : const
	}
	class "writable_vec_like" <<concept>>
	{
		+ !is_const_v<remove_reference_t<V>>
		+ set()
		+ as_derived()
		+ operator[](int)
		+ operator[](size_t)
		+ at(int)
		+ at(size_t)
		+ begin() / rbegin()
	}
	"vec_like" <|-- "writable_vec_like" : refines
	abstract vec_interface <Writable, T, Count, Derived>
	{
		+ set()
		+ operator[]()
		+ at()
		+ iterator access()
		+ length()
		+ size()
		+ as_derived()
		+ apply()
		+ query()
		+ shift()
		+ cshift()
		+ min()
		+ max()
		+ sum()
	}
	struct swizzle_vec_const_iterator<T, Size, Count, ...Is>
	{
		+ mapper_ptr : const swizzle_vec<T, Size, Count, Is ...> *
		+ mapper_index : std::ptrdiff_t
		+ iterator access()
	}
	struct swizzle_vec_iterator<T, Size, Count, ...Is>
	{
		+ iterator access()
	}
	struct vec<T, Size>
	{
		+ union
		+ set()
		+ operator[]()
		+ at()
		+ operator=()
		+ iterator access()
		+ swap()
	}
	annotation vec::anonymous_union
	{
		+ base
		+ swizzles
	}
	struct vec_storage<T, Size>
	{
		+ store : std::array<T, Size>
		+ set()
		+ operator[]()
		+ at()
		+ iterator access()
		+ length()
		+ size()
		+ swap()
	}
	struct swizzle_vec<T, Size, Count, ...Is>
	{
		+ base : std::array<T, Size>
		+ {static} offsets : std::array<T, Count>
		+ set()
		+ operator[]()
		+ at()
		+ operator=()
		+ sequence()
		+ iterator access()
	}
	struct mat<T, Cols, Rows>
	{
		+ columns : std::array<vec<T, Rows>, Cols>
		+ row()
		+ column()
		+ diagonal()
		+ trace()
		+ operator[]()
		+ at()
		+ operator=()
		+ iterator access()
		+ length()
		+ column_length()
		+ size()
		+ column_size()
		+ swap()
	}
	vec_interface <|-- vec: inherits
	vec_interface <|-- swizzle_vec : inherits
	swizzle_vec_const_iterator <|-- swizzle_vec_iterator
	"vec_like" ^.. vec : satisfies
	"vec_like" ^.. swizzle_vec : satisfies
	"writable_vec_like" ^.. vec : satisfies
	"writable_vec_like" ^.. swizzle_vec : satisfies
	vec::anonymous_union::base "1" *-- "1" vec_storage : base
	vec::anonymous_union::swizzles "1" *-- "many" swizzle_vec : swizzles
	vec::union "1" *-- "1" vec::anonymous_union
	note right on link
	  Nested anonymous union where
	  all members have a common initial
	  sequence with each other
	end note
	swizzle_vec_const_iterator "many" --> "1" swizzle_vec : mapper_ptr
	swizzle_vec_iterator "many" --> "1" swizzle_vec : mapper_ptr
	"vec_like" <. vec_interface : constrains Derived (CRTP, unconditional)
	"writable_vec_like" <. vec_interface : constrains Derived (CRTP, when Writable=true)
	mat::columns "1" *-- "Cols" vec : columns
	vec -[hidden]left- swizzle_vec
	vec_storage .[hidden]right. mat
@enduml
