@startuml
	'skin rose
	title Relationships - Class Diagram
	annotation "CRTP duck type"
	{
		+ {abstract} set()
		+ {abstract} operator[]()
		+ {abstract} sequence()
		+ {abstract} iterator access()
	}
	note left of "CRTP duck type"
		Conceptual interface, not real :
		Could be made into a c++ concept
	end note
	abstract vec_interface <Writable, T, Count, Derived>
	{
		+ CRTP set()
		+ CRTP operator[]()
		+ CRTP sequence()
		+ CRTP iterator access()
		+ length()
		+ size()
		+ as_derived()
		+ as_base()
		+ apply()
		+ query()
		+ shift()
		+ cshift()
		+ min()
		+ max()
		+ sum()
	}
	struct swizzle_vec_const_iterator<T, Size, Count, ...Is>
	{
		+ mapper_ptr : const swizzle_vec<T, Size, Count, Is ...> *
		+ mapper_index : std::ptrdiff_t
		+ iterator access()
	}
	struct swizzle_vec_iterator<T, Size, Count, ...Is>
	{
		+ iterator access()
	}
	struct vec<T, Size>
	{
		+ union
		+ {static} offsets : std::array<T, Size>
		+ set()
		+ operator[]()
		+ operator=()
		+ sequence()
		+ iterator access()
		+ swap()
	}
	annotation vec::anonymous_union
	{
		+ base
		+ swizzles
	}
	struct vec_storage<T, Size>
	{
		+ store : std::array<T, Size>
		+ {static} offsets : std::array<T, Size>
		+ set()
		+ operator[]()
		+ sequence()
		+ iterator access()
		+ length()
		+ size()
		+ swap()
	}
	struct swizzle_vec<T, Size, Count, ...Is>
	{
		+ base : std::array<T, Size>
		+ {static} offsets : std::array<T, Count>
		+ set()
		+ operator[]()
		+ operator=()
		+ sequence()
		+ iterator access()
	}
	struct mat<T, Cols, Rows>
	{
		+ columns : std::array<vec<T, Rows>, Cols>
		+ row()
		+ operator[]()
		+ operator=()
		+ iterator access()
		+ length()
		+ column_length()
		+ size()
		+ column_size()
		+ swap()
	}
	vec_interface <|-- vec: CRTP inherits
	vec_interface <|-- swizzle_vec : CRTP inherits
	swizzle_vec_const_iterator <|-- swizzle_vec_iterator : const_cast<>
	"CRTP duck type" ^.. vec : duck implements
	"CRTP duck type" ^.. swizzle_vec : duck implements
	vec::anonymous_union::base "1" *-- "1" vec_storage : base
	vec::anonymous_union::swizzles "1" *-- "many" swizzle_vec : swizzles
	vec::union "1" *-- "1" vec::anonymous_union
	note right on link
	  Nested anonymous union where
	  all members have a common initial
	  sequence with each other
	end note
	swizzle_vec_const_iterator::mapper_ptr "1" *-- "many" swizzle_vec : mapper_ptr
	swizzle_vec_iterator::mapper_ptr "1" *-- "many" swizzle_vec : mapper_ptr
	"CRTP duck type" <. vec_interface : Derived CRTP
	mat::columns "1" *-- "Cols" vec : columns
	vec -[hidden]left- swizzle_vec
	vec_storage .[hidden]right. mat
@enduml
