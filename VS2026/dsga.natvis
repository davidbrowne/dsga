	<Type Name="dsga::swizzle_vec_iterator&lt;*,*,*,*&gt;">
		<AlternativeType Name="dsga::swizzle_vec_const_iterator&lt;*,*,*,*&gt;" />
		<DisplayString Condition="mapper_index == 0">{{ value = {(*mapper_ptr).base[$T4],g} }}</DisplayString>
		<DisplayString Condition="mapper_index == 1">{{ end }}</DisplayString>
		<DisplayString>{{ ??? }}</DisplayString>
		<Expand HideRawView="true">
